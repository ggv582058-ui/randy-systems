{
  "name": "randy-whatsapp-bot",
  "version": "1.1.0",
  "description": "Bot modular de WhatsApp para Randy, basado en Baileys",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "start:prod": "sh ./scripts/start-production.sh",
    "dev": "node --watch src/index.js",
    "check": "node --check src/index.js && node --check src/config.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "axios": "^1.11.0",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "mathjs": "^14.6.0",
    "openai": "^5.16.0",
    "pino": "^9.9.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "sharp": "^0.34.3",
    "redis": "^5.8.2"
  }
}
