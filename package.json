{
  "name": "randy-whatsapp-bot",
  "version": "1.2.1",
  "description": "Bot modular de WhatsApp para Randy, basado en Baileys",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "postinstall": "node scripts/patch-baileys-pairing.js",
    "start": "node src/index.js",
    "start:prod": "sh ./scripts/start-production.sh",
    "dev": "node --watch src/index.js",
    "check": "node --check src/index.js && node --check src/config.js && node --check src/commands/downloads.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@whiskeysockets/baileys": "github:poison/Baileys#834dc742e349958fd162f7a2239514e9b237fb5a",
    "axios": "^1.11.0",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "link-preview-js": "^3.2.0",
    "mathjs": "^14.6.0",
    "openai": "^5.16.0",
    "pino": "^9.9.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "redis": "^5.8.2",
    "sharp": "^0.34.3",
    "youtube-dl-exec": "^3.1.15"
  }
}
